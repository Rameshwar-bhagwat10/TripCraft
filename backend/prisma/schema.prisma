datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  fullName            String?
  avatarUrl           String?
  language            String             @default("en")
  currency            String             @default("USD")
  onboardingCompleted Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  preferences         UserPreferences?
  savedDestinations   SavedDestination[]
  ownedTrips          Trip[]             @relation("OwnedTrips")
  tripMemberships     TripMember[]

  @@map("profiles")
}

model UserPreferences {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelStyles                String[] @default([])
  interests                   String[] @default([])
  budgetLevel                 String   @default("Moderate")
  travelPace                  String   @default("Balanced")
  companionTypes              String[] @default([])
  activityPreferences         String[] @default([])
  reducedMotion               Boolean  @default(false)
  largerText                  Boolean  @default(false)
  highContrast                Boolean  @default(false)
  personalizedRecommendations Boolean  @default(true)
  aiPersonalization           Boolean  @default(true)
  contextualSuggestions       Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("user_preferences")
}

model Destination {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  city            String
  country         String
  region          String
  description     String
  heroImage       String
  images          String[]           @default([])
  categories      String[]           @default([])
  travelStyles    String[]           @default([])
  activities      String[]           @default([])
  highlights      String[]           @default([])
  bestTimeToVisit String?
  budgetRange     String             @default("Moderate")
  latitude        Float?
  longitude       Float?
  rating          Float              @default(4.8)
  reviewCount     Int                @default(120)
  isFeatured      Boolean            @default(false)
  isTrending      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  savedBy         SavedDestination[]
  trips           Trip[]

  @@map("destinations")
}

model SavedDestination {
  id            String      @id @default(uuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, destinationId])
  @@map("saved_destinations")
}

model Trip {
  id             String       @id @default(uuid())
  ownerId        String
  destinationId  String
  title          String
  description    String?
  coverImage     String
  startDate      DateTime
  endDate        DateTime
  status         String       @default("Upcoming") // Draft, Upcoming, Ongoing, Completed, Archived
  travelersCount Int          @default(1)
  visibility     String       @default("Private")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  owner          User         @relation("OwnedTrips", fields: [ownerId], references: [id], onDelete: Cascade)
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  members        TripMember[]
  days           TripDay[]

  @@map("trips")
}

model TripMember {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  role      String   @default("Owner") // Owner, Editor, Viewer
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_members")
}

model TripDay {
  id        String          @id @default(uuid())
  tripId    String
  date      DateTime
  dayNumber Int
  title     String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

model ItineraryItem {
  id          String   @id @default(uuid())
  tripDayId   String
  placeId     String?
  title       String
  description String?
  type        String   @default("sightseeing") // sightseeing, food, hotel, transport, shopping, entertainment, nature, experience, event, custom
  startTime   String?
  endTime     String?
  duration    String?
  orderIndex  Int      @default(0)
  notes       String?
  imageUrl    String?
  isAllDay    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tripDay     TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@map("itinerary_items")
}
